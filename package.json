{
  "name": "posselect-shell",
  "version": "1.0.0",
  "private": true,
  "description": "posselect 공통 사이트 셸(Header/Footer) — customer.front/home.front/product.front가 <script> 태그로 로드해 쓰는 독립 배포 런타임 마이크로프론트엔드. @posselect/ui(디자인 시스템)를 조합해 라우팅/데이터 페칭 지식을 담는다.",
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.header.config.ts && vite build --config vite.footer.config.ts",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage"
  },
  "dependencies": {
    "@posselect/ui": "github:lee-dohyun/posselect-ui#main",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@storybook/test-runner": "^0.24.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.5",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "storybook": "^10.5.8",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
